# En-têtes servis par Cloudflare Pages.
# Quand plusieurs règles visent une URL, leurs en-têtes s'additionnent et deux
# valeurs d'un même en-tête sont jointes par une virgule (deux CSP cumulées =
# l'intersection des deux) : /admin/* retire donc la CSP de /* avec « ! » avant
# de poser la sienne. www.netlify.com reste dans img-src pour le bouton « Deploy
# to Netlify » de l'article email-alias-manager.
# frame-src : lecteur des vidéos {% youtube %} (js/youtube.js), chargé au clic.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; img-src 'self' data: https://www.netlify.com; script-src 'self' https://static.cloudflareinsights.com; style-src 'unsafe-inline'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  # Retire l'Access-Control-Allow-Origin: * que Pages ajoute par défaut.
  ! Access-Control-Allow-Origin
  Referrer-Policy: no-referrer-when-downgrade
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Sveltia CMS : API GitHub (et son statut), polices d'icônes sur jsDelivr,
# aperçus blob: et avatars GitHub. Reprend l'ancienne CSP globale, qui fonctionnait.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; connect-src 'self' blob: https://cloudflareinsights.com https://api.github.com https://www.githubstatus.com; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.netlify.com https://avatars.githubusercontent.com; script-src 'self' https://static.cloudflareinsights.com; style-src 'unsafe-inline'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; object-src 'none'

# Noms de fichiers sans hash (copiés de node_modules) : pas d'immutable, une
# mise à jour de fontsource doit finir par arriver chez les visiteurs.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Images optimisées par eleventy-img (parse-transform.js) : le nom contient un
# hash du contenu, une nouvelle version change d'URL.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Feuille XSLT des flux (/feed.xml) : servie comme XML pour que le navigateur l'applique.
/feed.xsl
  Content-Type: text/xsl; charset=utf-8

# Version Markdown des articles (src/article-markdown.njk) et llms.txt
/article/:slug/index.md
  Content-Type: text/markdown; charset=utf-8
/en/article/:slug/index.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Alias Mastodon (src/webfinger.njk) et handle Bluesky (src/atproto-did.njk)
/.well-known/webfinger
  Content-Type: application/jrd+json
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8

# SocialSpec (https://socialspec.org) : lisibles depuis n'importe quelle origine.
/.well-known/following.opml
  Content-Type: text/x-opml; charset=utf-8
  Access-Control-Allow-Origin: *
/.well-known/about.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
/.well-known/contact.vcf
  Content-Type: text/vcard; charset=utf-8
  Access-Control-Allow-Origin: *

# Scripts nommés d'après leur contenu (filtre hashed, /js/v/nom.<empreinte>.js) :
# une nouvelle version change d'URL.
/js/v/*
  Cache-Control: public, max-age=31536000, immutable
