---
# One page per tag of the French articles (eleventy.config.js, collection
# postTagList): not a deny-list of the other collections, which would miss new ones
pagination:
  data: collections.postTagList
  size: 1
  alias: tag
  addAllPagesToCollections: true
permalink: /tags/{{ tag }}/
layout: layouts/base.njk
eleventyComputed:
  title: "Articles #{{ tag }}"
  metaDesc: "Articles de Sylvain MÉTAYER avec le tag {{ tag }}."
---
{% from 'partials/macros.njk' import cmd, postList with context %}
<section class="section" aria-labelledby="page-title">
  {{ cmd('grep -rl "#' + tag + '" articles/') }}
  <h1 id="page-title" class="page-title">#{{ tag }}</h1>
  {% set count = collections[tag].length %}
  <p class="page-lead">{{ count }} article{% if count > 1 %}s{% endif %} · <a href="/articles/">tous les articles</a></p>
</section>
{{ postList(collections[tag] | reverse, true) }}
