---js
// No page until the first published note: paginating an empty collection builds nothing
const title = 'Notes';
const pagination = { data: 'collections.notes', size: Infinity };
const permalink = '/notes/';
const layout = 'layouts/base.njk';
const metaDesc = "Notes courtes de Sylvain MÉTAYER : ce que j'apprends au fil des jours.";
---
{% from 'partials/macros.njk' import cmd, postList with context %}
<section class="section" aria-labelledby="page-title">
  {{ cmd('ls -t notes/') }}
  <h1 id="page-title" class="page-title">Notes</h1>
  <p class="page-lead">{{ 'notes.lead' | t }}</p>
  <p><a href="/notes/feed.xml">{{ 'notes.feed' | t }}</a></p>
  {{ postList(collections.notes) }}
</section>
