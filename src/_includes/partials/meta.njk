{% set pageTitle = title + ' · ' + site.name %}
{% set pageDesc = site.shortDesc %}
{% set siteTitle = site.name %}
{% set currentUrl = canonical or (helpers.url() + page.url) %}
{% set socialImage = socialImage or site.socialImage %}

{% if metaTitle %}
  {% set pageTitle = metaTitle %}
{% endif %}

{% if metaDesc %}
  {% set pageDesc = metaDesc %}
{% elif excerpt %}
  {% set pageDesc = excerpt %}
{% endif %}

<title>{{ pageTitle }}</title>
<meta property="og:locale" content="{{ 'meta.ogLocale' | t }}"/>
<link rel="canonical" href="{{ currentUrl }}"/>
<meta name="author" content="{{ site.authorName }}" />
<meta property="og:site_name" content="{{ siteTitle }}"/>
<meta property="og:title" content="{{ pageTitle }}"/>
<meta property="og:url" content="{{ currentUrl }}"/>

{% if site.authorHandle %}
  <meta name="twitter:creator" content="@{{ site.authorHandle | replace('@', '') }}"/>
  <meta name="twitter:site" content="@{{ site.authorHandle | replace('@', '') }}"/>
{% endif %}

<meta name="description" content="{{ pageDesc }}"/>
<meta name="twitter:description" content="{{ pageDesc }}"/>
<meta property="og:description" content="{{ pageDesc }}"/>

{% if socialImage %}
  <meta property="og:image" content="{{helpers.url() }}{{ socialImage }}"/>
  <meta name="twitter:image" content="{{helpers.url() }}{{ socialImage }}"/>
  <meta property="og:image:alt" content="{{ 'meta.imageAlt' | t({ title: pageTitle }) }}"/>
  <meta name="twitter:image:alt" content="{{ 'meta.imageAlt' | t({ title: pageTitle }) }}"/>
{% endif %}

{% for me in relations.me %}
  <link rel="me" href="{{ me }}"/>
{% endfor %}

<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#0e1621" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)">

<link type="text/plain" rel="author" href="{{ helpers.url() }}/humans.txt"/>

<link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/icons/favicon-16x16.png">
<link rel="manifest" href="/manifest.json">

{# The webmention.io account domain, without scheme: mentions are received on it #}
<link rel="webmention" href="https://webmention.io/{{ site.webmentionDomain }}/webmention" />
<link rel="pingback" href="https://webmention.io/{{ site.webmentionDomain }}/xmlrpc" />