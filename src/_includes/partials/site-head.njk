{%- set home = langPrefix + '/' -%}
{%- set otherLang = 'fr' if lang == 'en' else 'en' -%}
<a class="skip-link" href="#main-content">{{ 'a11y.skip' | t }}</a>
<header class="site-head">
  <div class="wrap">
    <a href="{{ home }}" class="brand"{% if page.url == home %} aria-current="page"{% endif %}>
      <span>~/sylvain.dev</span><span class="prompt" aria-hidden="true">$</span><span class="cursor" aria-hidden="true"></span>
      <span class="visually-hidden">: {{ 'a11y.home' | t }}</span>
    </a>
    <nav class="nav" aria-label="{{ 'a11y.mainNav' | t }}">
      <ul>
        {% for item in navigation.items %}
          {# page.url is false for unpublished drafts (permalink: false), which are still rendered #}
          {% set url = page.url or '' %}
          {% set isCurrent = url == item.url or (item.url != home and url.startsWith(item.url)) or (item.url == langPrefix + '/articles/' and (url.startsWith(langPrefix + '/article/') or url.startsWith('/tags/'))) %}
          {# "page" only on the page itself; inside a section (an article, a tag) the item is the current location #}
          <li><a href="{{ item.url }}"{% if url == item.url %} aria-current="page"{% elif isCurrent %} aria-current="true"{% endif %}>{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {# Same page in the other language, or its home page when there is no translation #}
    <a class="lang-switch" href="{{ alternate or ('/' if lang == 'en' else '/en/') }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}" aria-label="{{ 'lang.switchLabel' | t }}">{{ otherLang | upper }}</a>
    <button type="button" class="palette-trigger" data-palette-open hidden aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" aria-label="{{ 'palette.open' | t }}" title="{{ 'palette.open' | t }} (ctrl k)">
      <svg class="palette-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="6.5" cy="6.5" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 10l4.25 4.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <fieldset class="theme-switch" data-theme-switch hidden>
      <legend class="visually-hidden">{{ 'theme.legend' | t }}</legend>
      <button type="button" data-theme-value="auto" aria-pressed="true">{{ 'theme.auto' | t }}</button>
      <button type="button" data-theme-value="dark" aria-pressed="false">{{ 'theme.dark' | t }}</button>
      <button type="button" data-theme-value="light" aria-pressed="false">{{ 'theme.light' | t }}</button>
    </fieldset>
  </div>
</header>
