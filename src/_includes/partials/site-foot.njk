{% from 'partials/icons.njk' import icon %}
<footer class="site-foot">
  <div class="wrap">
    <p>© {{ global.now | date('YYYY') }} {{ site.authorName }} · {{ 'foot.generated' | t({ eleventy: '<a href="https://www.11ty.dev/">Eleventy</a>', date: global.now | date('YYYY-MM-DD') }) | safe }}{% if global.commit %} · <a href="{{ global.repository }}/commit/{{ global.commit }}">commit {{ global.commit | truncate(7, true, '') }}</a>{% endif %}</p>
    <ul class="site-foot-social">
      {% for link in social.links %}
        <li><a href="{{ link.url }}" rel="me">{{ icon(link.icon) }}<span class="visually-hidden">{{ link.label }}</span></a></li>
      {% endfor %}
      <li><a href="mailto:{{ site.authorEmail }}">{{ icon('mail') }}<span class="visually-hidden">{{ 'foot.email' | t({ email: site.authorEmail }) }}</span></a></li>
    </ul>
    <ul>
      <li><a href="{{ 'url.feeds' | t }}">{{ icon('rss') }}rss</a></li>
      <li><a href="{{ langPrefix }}/now/">now</a></li>
      {% if links.links.length or karakeep.length %}<li><a href="/liens/" lang="fr" hreflang="fr">liens</a></li>{% endif %}
      {% if collections.notes.length %}<li><a href="/notes/" hreflang="fr">notes</a></li>{% endif %}
      <li><a href="/hasard/" lang="fr" hreflang="fr">hasard</a></li>
      <li><a href="{{ langPrefix }}/uses/">uses</a></li>
      <li><a href="{{ 'url.underTheHood' | t }}">{{ 'foot.underTheHood' | t }}</a></li>
      <li><a href="/sitemap.xml">sitemap</a></li>
      <li><a href="/humans.txt">humans.txt</a></li>
      <li><a href="{{ global.repository }}">{{ icon('github') }}sources</a></li>
    </ul>
  </div>
</footer>
