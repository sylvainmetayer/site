{# Shared building blocks for the post list and project cards. Import them
   `with context`: their strings follow the language of the page (filter `t`). #}

{# Shell lines only imitate a terminal and repeat the heading that follows: hidden from screen readers #}
{% macro cmd(text) %}<p class="cmd" aria-hidden="true"><span class="prompt">$</span> {{ text }}</p>{% endmacro %}

{# Where a republished post first appeared. Co-authors are handles on that platform, linked on dev.to only. #}
{% macro origin(canonical, publisher, coauthors) -%}
  {%- set host = canonical | siteName -%}
  <a href="{{ canonical }}">{{ host }}</a>
  {%- if publisher %}{{ 'origin.publisher' | t({ publisher: publisher }) }}{% endif %}
  {%- if coauthors %}{{ 'origin.with' | t }}{% for handle in coauthors %}{% if host == 'dev.to' %}<a href="https://dev.to/{{ handle }}">@{{ handle }}</a>{% else %}@{{ handle }}{% endif %}{% if loop.revindex == 2 %}{{ 'origin.and' | t }}{% elif not loop.last %}, {% endif %}{% endfor %}{% endif %}
{%- endmacro %}

{# Years a talk was given: "2023 → 2025", or "2024" when all sessions fall in one year #}
{% macro talkYears(talk) -%}
  {%- set sessions = talk.sessions | sort(false, false, 'date') -%}
  {%- set firstYear = (sessions | first).date | date('YYYY') -%}
  {%- set lastYear = (sessions | last).date | date('YYYY') -%}
  {{ firstYear }}{% if lastYear != firstYear %} → {{ lastYear }}{% endif %}
{%- endmacro %}

{# Start → end of a role, "aujourd'hui" / "present" when it is ongoing. The PDF passes "–": its fonts have no arrow #}
{% macro period(start, end, format, separator = '→') -%}
  {{ start | date(format) }} {{ separator }} {% if end %}{{ end | date(format) }}{% else %}{{ 'period.now' | t }}{% endif %}
{%- endmacro %}

{% macro postList(posts, showExcerpt = false) %}
  <ol class="post-list" reversed>
    {% for post in posts %}
      <li class="post-row">
        <time datetime="{{ post.date | w3DateFilter }}">{{ post.date | date('YYYY-MM-DD') }}</time>
        {# On an English page, an article without translation stays in French #}
        {% if post.data.lang != lang %}
          <a href="{{ post.url }}" rel="bookmark" lang="{{ post.data.lang }}" hreflang="{{ post.data.lang }}">{{ post.data.title }}</a> <span class="post-lang">{{ 'lang.inFrench' | t }}</span>
        {% else %}
          <a href="{{ post.url }}" rel="bookmark">{{ post.data.title }}</a>
        {% endif %}
        {% if showExcerpt and post.data.excerpt %}
          <p class="excerpt"{% if post.data.lang != lang %} lang="{{ post.data.lang }}"{% endif %}>{{ post.data.excerpt }}</p>
        {% endif %}
        {% if post.data.tags %}
          <span class="tags">{% for tag in post.data.tags %}#{{ tag }}{% if not loop.last %} {% endif %}{% endfor %}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
{% endmacro %}

{# level: heading level of the card titles, one below the section heading #}
{% macro projectCards(projects, level = 3) %}
  <div class="cards">
    {% for project in projects %}
      <article class="card" id="{{ project.fileSlug | baseSlug }}">
        {# On an English page, a project without translation keeps its French description #}
        {% set untranslated = project.data.lang != lang %}
        <h{{ level }} class="card-title">{{ project.data.title }} <small>{% if untranslated %}<span class="post-lang">{{ 'lang.inFrench' | t }}</span> · {% endif %}{{ project.data.year }}</small></h{{ level }}>
        <div class="desc"{% if untranslated %} lang="{{ project.data.lang }}"{% endif %}>{{ project.templateContent | safe }}</div>
        {% if project.data.stack %}
          <ul class="chips">
            {% for tech in project.data.stack %}<li>{{ tech }}</li>{% endfor %}
          </ul>
        {% endif %}
        {% if project.data.repo or project.data.article %}
          <p class="actions">
            {# The project name makes the repeated "sources" / "article" links unambiguous out of context #}
            {% if project.data.repo %}<a href="{{ project.data.repo }}">{{ 'projects.sources' | t }}<span class="visually-hidden">{{ 'projects.sourcesOf' | t({ title: project.data.title }) }}</span> <span aria-hidden="true">↗</span></a>{% endif %}
            {% if project.data.article %}
              {# The article in the language of the page, or marked when it has no translation #}
              {% set article = project.data.article | localLink(collections.all) %}
              <a href="{{ article.url }}"{% if article.lang != lang %} hreflang="{{ article.lang }}"{% endif %}>article<span class="visually-hidden">{{ 'projects.articleOn' | t({ title: project.data.title }) }}</span> <span class="arrow" data-arrow="→" aria-hidden="true"></span></a>{% if article.lang != lang %} <span class="post-lang">{{ 'lang.inFrench' | t }}</span>{% endif %}
            {% endif %}
          </p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
{% endmacro %}
