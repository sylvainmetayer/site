{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import cmd, origin %}

{% block extraMeta %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ date | w3DateFilter }}">
  {% if tags | length > 0 %}
    <meta property="article:tag" content="{{ tags | join(' ') }}">
  {% endif %}
{% endblock %}

{% block content %}
  {% set readingTime = helpers.getReadingTime(content) %}
  <article class="post h-entry" aria-labelledby="post-title">
    <header class="post-head">
      <p class="cmd" aria-hidden="true">~/articles/{{ page.fileSlug }}.md</p>
      <h1 id="post-title" class="p-name">{{ title }}</h1>
      <ul class="meta">
        <li><time datetime="{{ date | w3DateFilter }}" class="dt-published">{{ date | date('YYYY-MM-DD') }}</time></li>
        <li>{{ readingTime }} min de lecture</li>
        {% for tag in tags %}
          <li><a href="/tags/{{ tag }}/" class="p-category">#{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </header>

    {% if canonical %}
      <p class="post-notice">Article publié à l'origine sur {{ origin(canonical, originalPublisher, coauthors) }}.</p>
    {% endif %}
    {# Rebuilt every morning (daily_build.yml), so the age stays current #}
    {% if (global.now - page.date.getTime()) > 31557600000 %}
      <p class="post-notice">Article de {{ page.date | date('YYYY') }} : certaines informations ont pu changer depuis.</p>
    {% endif %}

    {% set tocContent = content | toc %}
    {% if tocContent and ('<li' in tocContent) and not noToc %}
      <aside class="toc" aria-label="Sommaire">
        <p class="cmd" aria-hidden="true"><span class="prompt">$</span> grep "^##" {{ page.fileSlug }}.md</p>
        {{ tocContent | safe }}
      </aside>
    {% endif %}

    <div class="prose e-content">
      {{ content | safe }}
    </div>

    {% if tags %}
      <ul class="post-tags">
        {% for tag in tags %}<li><a href="/tags/{{ tag }}/">#{{ tag }}</a></li>{% endfor %}
      </ul>
    {% endif %}
  </article>

  {% set newer = collections.posts | getPreviousCollectionItem(page) %}
  {% set older = collections.posts | getNextCollectionItem(page) %}
  {% if newer or older %}
    <nav class="post-nav" aria-label="Articles voisins">
      {% if older %}
        <a href="{{ older.url }}" class="prev" rel="prev"><span><span aria-hidden="true">← </span>précédent<span class="visually-hidden"> :</span></span>{{ older.data.title }}</a>
      {% endif %}
      {% if newer %}
        <a href="{{ newer.url }}" class="next" rel="next"><span>suivant<span class="visually-hidden"> :</span><span aria-hidden="true"> →</span></span>{{ newer.data.title }}</a>
      {% endif %}
    </nav>
  {% endif %}
{% endblock %}
