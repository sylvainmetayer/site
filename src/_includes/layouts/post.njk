{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import cmd, origin, breadcrumb with context %}

{% block extraMeta %}
  <meta property="og:type" content="article">
  <link rel="alternate" type="text/markdown" href="{{ page.url }}index.md">
  <meta property="article:published_time" content="{{ date | w3DateFilter }}">
  {% if updated %}
    <meta property="article:modified_time" content="{{ updated | w3DateFilter }}">
  {% endif %}
  {% if tags | length > 0 %}
    <meta property="article:tag" content="{{ tags | join(' ') }}">
  {% endif %}
{% endblock %}

{% block head %}
  <script src="/js/toc-spy.js" defer></script>
  <script src="/js/youtube.js" defer></script>
  <script src="/js/copy-code.js" data-label="{{ 'code.copy' | t }}" data-copied="{{ 'code.copied' | t }}" defer></script>
{% endblock %}

{% block content %}
  {# The articles in the language of the page: the English ones are only the translated ones #}
  {% set siblings = collections.postsEn if lang == 'en' else collections.posts %}
  {% set readingTime = helpers.getReadingTime(content) %}
  <article class="post h-entry" aria-labelledby="post-title">
    <header class="post-head">
      {{ breadcrumb([{ name: 'articles', url: langPrefix + '/articles/' }], page.fileSlug + '.md') }}
      <h1 id="post-title" class="p-name">{{ title }}</h1>
      <ul class="meta">
        <li><time datetime="{{ date | w3DateFilter }}" class="dt-published">{{ date | date('YYYY-MM-DD') }}</time></li>
        {# Author of the h-entry, for webmention receivers and microformats readers #}
        <li class="visually-hidden"><a class="p-author h-card" href="{{ helpers.url() }}/">{{ site.authorName }}</a></li>
        {% if updated %}
          <li>{{ 'post.updated' | t({ date: '<time datetime="' + (updated | w3DateFilter) + '" class="dt-updated">' + (updated | date('YYYY-MM-DD')) + '</time>' }) | safe }}</li>
        {% endif %}
        <li>{{ 'post.readingTime' | t({ minutes: readingTime }) }}</li>
        {% for tag in tags %}
          <li><a href="/tags/{{ tag }}/" class="p-category">#{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </header>

    {% if canonical %}
      <p class="post-notice">{{ 'post.origin' | t({ origin: origin(canonical, originalPublisher, coauthors) }) | safe }}</p>
    {% elif original %}
      {# English translation of an article first published in French elsewhere #}
      <p class="post-notice">{{ 'post.translation' | t({ origin: origin(original, originalPublisher, coauthors) }) | safe }}</p>
    {% endif %}
    {# French article without translation: told to English readers only, in English
       (shown by src/js/lang-suggest.js: browser in English or coming from /en/) #}
    {% if lang == 'fr' and not alternate %}
      <p class="post-notice" data-untranslated="en" lang="en" hidden>{{ 'post.untranslated' | t({ articles: '<a href="/en/articles/">' + ('post.untranslatedLink' | t({}, 'en')) + '</a>' }, 'en') | safe }}</p>
    {% endif %}
    {# Rebuilt every morning (daily_build.yml), so the age stays current.
       A review (`updated`) restarts it: the content was checked again then. #}
    {% set reviewed = updated or page.date %}
    {% if (global.now - reviewed.getTime()) > 31557600000 %}
      <p class="post-notice">{{ ('post.oldUpdated' if updated else 'post.old') | t({ year: reviewed | date('YYYY') }) }}</p>
    {% endif %}

    {# Articles sharing the `series` front matter, oldest first #}
    {% if series %}
      {% set seriesPosts = siblings | whereData('series', series) | reverse %}
      <nav class="series" aria-label="{{ 'post.series' | t({ name: series }) }}">
        <p>{{ 'post.series' | t({ name: series }) }} ({{ seriesPosts.length }})</p>
        <ol>
          {% for post in seriesPosts %}
            <li>{% if post.url == page.url %}<span aria-current="page">{{ post.data.title }}</span>{% else %}<a href="{{ post.url }}">{{ post.data.title }}</a>{% endif %}</li>
          {% endfor %}
        </ol>
      </nav>
    {% endif %}

    {% set tocContent = content | toc %}
    {% if tocContent and ('<li' in tocContent) and not noToc %}
      <aside class="toc" aria-label="{{ 'post.toc' | t }}">
        <p class="cmd" aria-hidden="true"><span class="prompt">$</span> grep "^##" {{ page.fileSlug }}.md</p>
        {{ tocContent | safe }}
      </aside>
    {% endif %}

    <div class="prose e-content">
      {{ content | safe }}
    </div>

    {% if tags %}
      <ul class="post-tags">
        {% for tag in tags %}<li><a href="/tags/{{ tag }}/">#{{ tag }}</a></li>{% endfor %}
      </ul>
    {% endif %}
  </article>

  {% set backlinkPosts = siblings | backlinks(page.fileSlug | baseSlug) %}
  {# Share links: plain links, no third-party script #}
  {% set shareUrl = helpers.url() + page.url %}
  <nav class="share" aria-label="{{ 'share.label' | t }}">
    <span>{{ 'share.label' | t }}<span class="visually-hidden"> :</span></span>
    <ul>
      <li><a href="https://shareopenly.org/share/?url={{ shareUrl | urlencode }}&amp;text={{ title | urlencode }}">Mastodon</a></li>
      <li><a href="https://bsky.app/intent/compose?text={{ (title + ' ' + shareUrl) | urlencode }}">Bluesky</a></li>
      <li><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}">LinkedIn</a></li>
    </ul>
  </nav>

  {% set relatedPosts = siblings | related(page.url, backlinkPosts) %}
  {% if relatedPosts.length or backlinkPosts.length %}
    <aside class="post-links" aria-label="{{ 'post.more' | t }}">
      {% if backlinkPosts.length %}
        <h2>{{ 'post.backlinks' | t }}</h2>
        <ul>{% for post in backlinkPosts %}<li><a href="{{ post.url }}">{{ post.data.title }}</a></li>{% endfor %}</ul>
      {% endif %}
      {% if relatedPosts.length %}
        <h2>{{ 'post.related' | t }}</h2>
        <ul>{% for post in relatedPosts %}<li><a href="{{ post.url }}">{{ post.data.title }}</a></li>{% endfor %}</ul>
      {% endif %}
    </aside>
  {% endif %}

  {% include 'partials/webmentions.njk' %}
  {% include 'partials/social-replies.njk' %}

  {# Neighbours in the same language: the English articles are only the translated ones #}
  {% set newer = siblings | getPreviousCollectionItem(page) %}
  {% set older = siblings | getNextCollectionItem(page) %}
  {% if newer or older %}
    <nav class="post-nav" aria-label="{{ 'post.neighbours' | t }}">
      {% if older %}
        <a href="{{ older.url }}" class="prev" rel="prev"><span><span class="arrow" data-arrow="← " aria-hidden="true"></span>{{ 'post.previous' | t }}<span class="visually-hidden"> :</span></span>{{ older.data.title }}</a>
      {% endif %}
      {% if newer %}
        <a href="{{ newer.url }}" class="next" rel="next"><span>{{ 'post.next' | t }}<span class="visually-hidden"> :</span><span class="arrow" data-arrow=" →" aria-hidden="true"></span></span>{{ newer.data.title }}</a>
      {% endif %}
    </nav>
  {% endif %}
{% endblock %}
