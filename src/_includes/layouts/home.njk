{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import cmd, postList, projectCards with context %}
{% from 'partials/icons.njk' import icon %}

{% block content %}
  {# h-card of the site's author: name, URL, note, other profiles (rel=me) #}
  <section class="hero h-card" aria-labelledby="hero-title">
    {{ cmd('whoami') }}
    <h1 id="hero-title"><a class="u-url u-uid" href="{{ helpers.url() }}/">{{ title }}</a></h1>
    <p class="visually-hidden"><span class="p-name">{{ site.authorName }}</span>, <span class="p-job-title">{{ site.role }}</span>, <span class="p-locality">{{ site.location }}</span></p>
    <div class="lead p-note">{{ content | safe }}</div>
    <ul class="links">
      {% for link in social.links %}
        <li><a href="{{ link.url }}" rel="me" class="u-url">{{ icon(link.icon) }}{{ link.label }}</a></li>
      {% endfor %}
      <li><a href="mailto:{{ site.authorEmail }}" class="u-email">{{ icon('mail') }}{{ site.authorEmail }}</a></li>
    </ul>
  </section>

  {# English home page: the latest articles in their English version when there is one #}
  {% set latest = (collections.postsAllEn | head(collections.postFeed.length)) if lang == 'en' else collections.postFeed %}
  {% set starred = collections.starFeed | translated(collections.all) %}
  {% if starred.length %}
    <section class="section" aria-labelledby="starred-title">
      {{ cmd('grep -l "star: true" articles/*') }}
      <h2 id="starred-title">{{ starHeading }}</h2>
      {{ postList(starred) }}
    </section>
  {% endif %}

  <section class="section" aria-labelledby="latest-title">
    {{ cmd('ls -t articles/ | head -' + latest.length) }}
    <h2 id="latest-title">{{ postsHeading }}</h2>
    {{ postList(latest) }}
    {% if latest.length < collections.posts.length %}
      <a class="more" href="{{ langPrefix }}/articles/"><span class="arrow" data-arrow="→ " aria-hidden="true"></span>{{ archiveButtonText }} ({{ collections.posts.length }})</a>
    {% endif %}
  </section>

  {% set featured = collections.projets | withData('featured') | translated(collections.all) %}
  {% if featured.length %}
    <section class="section" aria-labelledby="projects-title">
      {{ cmd('ls projets/') }}
      <h2 id="projects-title">{{ projectsHeading }}</h2>
      {{ projectCards(featured) }}
      <a class="more" href="{{ 'url.projects' | t }}"><span class="arrow" data-arrow="→ " aria-hidden="true"></span>{{ 'home.allProjects' | t({ count: collections.projets.length }) }}</a>
    </section>
  {% endif %}
{% endblock %}
