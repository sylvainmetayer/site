{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import cmd, postList, projectCards %}
{% from 'partials/icons.njk' import icon %}

{% block content %}
  <section class="hero" aria-labelledby="hero-title">
    {{ cmd('whoami') }}
    <h1 id="hero-title">{{ title }}</h1>
    <div class="lead">{{ content | safe }}</div>
    <ul class="links">
      {% for link in social.links %}
        <li><a href="{{ link.url }}" rel="me">{{ icon(link.icon) }}{{ link.label }}</a></li>
      {% endfor %}
      <li><a href="mailto:{{ site.authorEmail }}">{{ icon('mail') }}{{ site.authorEmail }}</a></li>
    </ul>
  </section>

  {% if collections.starFeed.length %}
    <section class="section" aria-labelledby="starred-title">
      {{ cmd('grep -l "star: true" articles/*') }}
      <h2 id="starred-title">{{ starHeading }}</h2>
      {{ postList(collections.starFeed) }}
    </section>
  {% endif %}

  <section class="section" aria-labelledby="latest-title">
    {{ cmd('ls -t articles/ | head -' + collections.postFeed.length) }}
    <h2 id="latest-title">{{ postsHeading }}</h2>
    {{ postList(collections.postFeed) }}
    {% if collections.postFeed.length < collections.posts.length %}
      <a class="more" href="/articles/"><span aria-hidden="true">→ </span>{{ archiveButtonText }} ({{ collections.posts.length }})</a>
    {% endif %}
  </section>

  {% set featured = collections.projets | withData('featured') %}
  {% if featured.length %}
    <section class="section" aria-labelledby="projects-title">
      {{ cmd('ls projets/') }}
      <h2 id="projects-title">{{ projectsHeading }}</h2>
      {{ projectCards(featured) }}
      <a class="more" href="/projets/"><span aria-hidden="true">→ </span>tous les projets ({{ collections.projets.length }})</a>
    </section>
  {% endif %}
{% endblock %}
