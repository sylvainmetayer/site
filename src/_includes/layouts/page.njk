{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import breadcrumb with context %}

{% block content %}
  <article class="post" aria-labelledby="page-title">
    <header class="post-head">
      {{ breadcrumb([], page.url | replace(langPrefix + '/', '/') | replace(r/^\/|\/$/g, '')) }}
      <h1 id="page-title" class="page-title">{{ title }}</h1>
      {% if updated %}
        <ul class="meta">
          <li>{{ 'post.updated' | t({ date: '<time datetime="' + (updated | w3DateFilter) + '">' + (updated | date('YYYY-MM-DD')) + '</time>' }) | safe }}</li>
        </ul>
      {% endif %}
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
  </article>
{% endblock %}
