{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import breadcrumb with context %}

{% block extraMeta %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ page.date | w3DateFilter }}">
{% endblock %}

{% block content %}
  <article class="post h-entry" aria-labelledby="post-title">
    <header class="post-head">
      {{ breadcrumb([{ name: 'notes', url: '/notes/' }], page.fileSlug + '.md') }}
      <h1 id="post-title" class="p-name">{{ title }}</h1>
      <ul class="meta">
        <li><time datetime="{{ page.date | w3DateFilter }}" class="dt-published">{{ page.date | date('LL') }}</time></li>
        <li class="visually-hidden"><a class="p-author h-card" href="{{ helpers.url() }}/">{{ site.authorName }}</a></li>
        <li><a href="/notes/">{{ 'notes.all' | t }}</a></li>
      </ul>
    </header>
    <div class="prose e-content">
      {{ content | safe }}
    </div>
  </article>
{% endblock %}
