{#- Same page in the other language, if it has one (src/11ty/i18n.js); langPrefix and otherLang come from src/_data/eleventyComputed.js -#}
{%- set alternatePage = translationKey | alternate(collections.all) -%}
{%- set alternate = alternatePage.url if alternatePage else null -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
  <head data-env="{{ global.environment }}">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="Eleventy">
    <script src="/js/theme.js"></script>
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ helpers.url() }}{{ langPrefix }}/feed.xml">
    {# No hreflang when either page is canonical elsewhere (article first published on
       dev.to, LinkedIn…): search engines drop clusters that point to non-canonical URLs #}
    {% if alternate and not canonical and not alternatePage.data.canonical %}
      <link rel="alternate" hreflang="{{ lang }}" href="{{ helpers.url() }}{{ page.url }}">
      <link rel="alternate" hreflang="{{ otherLang }}" href="{{ helpers.url() }}{{ alternate }}">
      <link rel="alternate" hreflang="x-default" href="{{ helpers.url() }}{{ page.url if lang == 'fr' else alternate }}">
    {% endif %}
    <link rel="icon" href="{{ site.faviconPath }}" type="image/svg+xml">
    <meta name="google-site-verification" content="XROrcW2Xt6g7cyF4SDNyz08GZeMB90QlstI3SBnUsq0">
    {% include "partials/meta.njk" %}
    {% block extraMeta %}
      <meta property="og:type" content="website">
    {% endblock %}
    <style>
      {% include "css/site.css" %}
    </style>
    {% block head %}{% endblock %}
  </head>
  <body>
    {% include "partials/site-head.njk" %}

    {% if site.displayWipWarning %}
      <div class="notice" role="note"><div class="wrap"><strong>wip:</strong> {{ 'notice.wip' | t }}</div></div>
    {% endif %}

    {% if site.displayDevWarning and global.environment != 'production' %}
      <div class="notice" role="note"><div class="wrap"><strong>warning:</strong> {{ 'notice.dev' | t }} <a href="{{ site.url }}">{{ site.url }}</a>.</div></div>
    {% endif %}

    <main id="main-content" tabindex="-1">
      <div class="wrap page">
        {% block content %}{{ content | safe }}{% endblock content %}
      </div>
    </main>

    {% include "partials/site-foot.njk" %}
    {% include "partials/palette.njk" %}
    {% include "partials/lang-suggest.njk" %}
    <script src="/js/palette.js" defer></script>
    <script src="/js/lang-suggest.js" defer></script>
    <script src="/js/register-service-worker.js" async defer></script>
    {% if site.cfBeaconToken and global.environment == 'production' %}
      {# Cloudflare Web Analytics: sylvain.dev is not a Cloudflare zone, so the beacon is not injected automatically (homelab tofu/site) #}
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>
    {% endif %}
  </body>
</html>
