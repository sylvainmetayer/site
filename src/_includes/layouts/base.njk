<!DOCTYPE html>
<html lang="{{ locale or site.locale }}">
  <head data-env="{{ global.environment }}">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/theme.js"></script>
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="alternate" type="application/atom+xml" title="{{ site.authorName }}" href="{{ helpers.url() }}/feed.xml">
    <link rel="icon" href="{{ site.faviconPath }}" type="image/png">
    <meta name="google-site-verification" content="XROrcW2Xt6g7cyF4SDNyz08GZeMB90QlstI3SBnUsq0">
    {% include "partials/meta.njk" %}
    {% block extraMeta %}
      <meta property="og:type" content="website">
    {% endblock %}
    <style>
      {% include "css/site.css" %}
    </style>
    {% block head %}{% endblock %}
  </head>
  <body>
    {% include "partials/site-head.njk" %}

    {% if site.displayWipWarning %}
      <div class="notice" role="note"><div class="wrap"><strong>wip:</strong> site en travaux, certaines pages peuvent être cassées.</div></div>
    {% endif %}

    {% if site.displayDevWarning and global.environment != 'production' %}
      <div class="notice" role="note"><div class="wrap"><strong>warning:</strong> vous consultez la version de développement. Le site en production est sur <a href="{{ site.url }}">{{ site.url }}</a>.</div></div>
    {% endif %}

    <main id="main-content" tabindex="-1">
      <div class="wrap page">
        {% block content %}{{ content | safe }}{% endblock content %}
      </div>
    </main>

    {% include "partials/site-foot.njk" %}
    <script src="/js/register-service-worker.js" async defer></script>
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b127465eed91464f811fad719b0c0cb7"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
