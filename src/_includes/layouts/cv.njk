{# CV page, in French (src/cv.njk) and English (src/en/cv.njk) #}
{% extends 'layouts/base.njk' %}
{% from 'partials/macros.njk' import cmd, talkYears, period with context %}
{% from 'partials/icons.njk' import icon %}

{% block content %}
<header class="cv-head">
  <div>
    {{ cmd('cat cv.md') }}
    <h1>{{ site.authorName }}</h1>
    <p class="role">{{ site.role }} · {{ site.location }} · {{ site.drivingLicence }} · <a href="mailto:{{ site.authorEmail }}">{{ site.authorEmail }}</a></p>
  </div>
  <a class="btn no-print" href="{{ 'cv.pdf' | t }}"><span class="arrow" data-arrow="↓ " aria-hidden="true"></span>cv.pdf<span class="visually-hidden">{{ 'cv.download' | t }}</span></a>
</header>

<section class="section" aria-labelledby="xp-title">
  <h2 id="xp-title">{{ 'cv.experience' | t }}</h2>
  <ol class="timeline">
    {% for work in collections.work | translated(collections.all) %}
      <li{% if not work.data.end %} class="current"{% endif %}>
        <span class="when">{{ period(work.data.start, work.data.end, 'YYYY-MM') }}</span>
        <div>
          <h3>{% if work.data.link %}<a href="{{ work.data.link }}">{{ work.data.title }}</a>{% else %}{{ work.data.title }}{% endif %}<small>{{ work.data.location }}</small></h3>
          {% if work.data.roles %}
            <ol class="roles">
              {% for role in work.data.roles %}
                <li>
                  <p class="role-head"><strong>{{ role.title }}</strong> <span class="role-when">{{ period(role.start, role.end, 'YYYY-MM') }} · {{ role.location }}</span></p>
                  {% if role.positions %}
                    <p class="role-positions">{% for position in role.positions %}{{ position.title }} {% if position.end %}{{ 'period.from' | t({ start: position.start | date('YYYY-MM'), end: position.end | date('YYYY-MM') }) }}{% else %}{{ 'period.since' | t({ start: position.start | date('YYYY-MM') }) }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</p>
                  {% endif %}
                  <ul>{% for mission in role.missions %}<li>{{ mission }}</li>{% endfor %}</ul>
                </li>
              {% endfor %}
            </ol>
          {% endif %}
          <div class="body">{{ work.templateContent | safe }}</div>
        </div>
      </li>
    {% endfor %}
  </ol>
</section>

<section class="section" aria-labelledby="talks-title">
  <h2 id="talks-title">Talks</h2>
  <ol class="timeline">
    {% for talk in talks.talks %}
      {% set sessions = talk.sessions | sort(true, false, 'date') %}
      <li>
        <span class="when">{{ talkYears(talk) }}</span>
        <div>
          <h3>{{ talk.title }}</h3>
          <div class="body"><p>{% for session in sessions %}{{ session.event }} {{ session.date | date('YYYY') }}{% if not loop.last %}, {% endif %}{% endfor %}</p></div>
        </div>
      </li>
    {% endfor %}
  </ol>
  <p class="no-print"><a href="{{ langPrefix }}/talks/">{{ 'talks.slidesAndReplays' | t }}</a></p>
</section>

<section class="section" aria-labelledby="edu-title">
  <h2 id="edu-title">{{ 'cv.education' | t }}</h2>
  <ol class="timeline">
    {% for formation in formations.formations | reverse %}
      <li>
        <span class="when">{% if formation.start %}{{ formation.start }} → {% endif %}{{ formation.end }}</span>
        <div>
          <h3>{% if formation.link %}<a href="{{ formation.link }}">{{ formation.title }}</a>{% else %}{{ formation.title }}{% endif %}<small>{{ formation.location }}</small></h3>
          {% if formation.description %}<div class="body"><p>{{ formation.description }}</p></div>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
</section>

<section class="section" aria-labelledby="cert-title">
  <h2 id="cert-title">{{ 'cv.certifications' | t }}</h2>
  <ol class="timeline">
    {% for cert in certifications.certifications | reverse %}
      <li>
        <span class="when">{{ cert.date | date('YYYY-MM') }}</span>
        <div>
          <h3>{% if cert.link %}<a href="{{ cert.link }}">{{ cert.title }}</a>{% else %}{{ cert.title }}{% endif %}</h3>
          {% if cert.description %}<div class="body"><p>{{ cert.description }}</p></div>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
</section>

<section class="section" aria-labelledby="skills-title">
  <h2 id="skills-title">{{ 'cv.skills' | t }}</h2>
  <dl class="skill-groups">
    {% for group in skills.groups %}
      <dt>{{ group.name }}</dt>
      <dd><ul class="chips">{% for skill in group.skills %}<li>{{ skill }}</li>{% endfor %}</ul></dd>
    {% endfor %}
  </dl>
</section>

<section class="section" aria-labelledby="languages-title">
  <h2 id="languages-title">{{ 'cv.languages' | t }}</h2>
  <ul class="interests">
    {% for language in languages.languages %}
      <li><strong>{{ language.label }}</strong> · {% if language.certification %}{% for cert in certifications.certifications %}{% if cert.title == language.certification %}{{ cert.title }} {{ cert.summary }}{% endif %}{% endfor %}{% else %}{{ language.level }}{% endif %}</li>
    {% endfor %}
  </ul>
</section>

<section class="section" aria-labelledby="interests-title">
  <h2 id="interests-title">{{ 'cv.interests' | t }}</h2>
  <ul class="interests">
    {% for interest in interests.interests %}
      <li><strong>{{ interest.label }}</strong>{% if interest.detail %} · {% if interest.link %}<a href="{{ interest.link }}">{{ interest.detail }}</a>{% else %}{{ interest.detail }}{% endif %}{% endif %}</li>
    {% endfor %}
  </ul>
</section>

<section class="section no-print" aria-labelledby="links-title">
  <h2 id="links-title">{{ 'cv.elsewhere' | t }}</h2>
  <ul class="links">
    {% for link in social.links %}<li><a href="{{ link.url }}">{{ icon(link.icon) }}{{ link.label }}</a></li>{% endfor %}
    <li><a href="mailto:{{ site.authorEmail }}">{{ icon('mail') }}{{ site.authorEmail }}</a></li>
  </ul>
</section>
{% endblock %}
