---
# English version of src/talks-qr.njk: leads to /en/talks/. Pagination reads
# talks.json as written, hence title_en.
pagination:
  data: talks.talks
  size: 1
  alias: talk
permalink: "/qr/en/talks/{{ talk.repo | replace(r/\\/$/, '') | replace(r/.*\\//, '') }}.svg"
eleventyExcludeFromCollections: true
---
{{ (helpers.url() + '/en/talks/#' + ((talk.title_en or talk.title) | slugify)) | qrSvg | safe }}
