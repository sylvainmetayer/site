{# js/random.js picks one of the listed articles and opens it; without
   JavaScript, the list stays for the reader to pick #}
<p>{{ 'random.lead' | t }}</p>
<ul data-random>
  {% for post in collections.posts %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
<script src="{{ '/js/random.js' | hashed }}" defer></script>
