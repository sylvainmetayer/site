{
  "name": "@sylvainmetayer/sylvainmetayer",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website",
  "main": "eleventy.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvainmetayer/sylvainmetayer.git"
  },
  "keywords": [
    "portfolio",
    "ssg",
    "eleventy"
  ],
  "type": "module",
  "author": "Sylvain MÉTAYER <bonjour@sylvain.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sylvainmetayer/sylvainmetayer/issues"
  },
  "homepage": "https://github.com/sylvainmetayer/sylvainmetayer#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sveltia/cms": "^0.229.0",
    "@tgwf/co2": "^0.19.0",
    "chrome-launcher": "^1.2.2",
    "cross-env": "^10.1.0",
    "eleventy-plugin-toc": "^1.1.5",
    "gray-matter": "^4.0.3",
    "html-validate": "^11.16.2",
    "image-size": "^2.0.4",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "moment": "^2.29.4",
    "pa11y-ci": "^4.1.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9"
  },
  "scripts": {
    "start": "npm run serve",
    "serve": "cross-env ELEVENTY_ENV=development eleventy --serve",
    "production": "eleventy",
    "validate": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs dist",
    "check:a11y": "node scripts/check-a11y.mjs dist",
    "cv:pdf": "node scripts/cv-pdf.mjs dist && node scripts/cv-pdf.mjs dist --lang en",
    "check:cv": "node scripts/check-cv-ats.mjs src/uploads/CV.pdf && node scripts/check-cv-ats.mjs src/uploads/CV-en.pdf --lang en"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "pa11y-ci": {
      "pa11y": "^10.0.0",
      "puppeteer": "^25.9.0"
    }
  }
}
