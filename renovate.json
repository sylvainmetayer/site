{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "description": "Extension gh-actions-lock du workflow verify-lockfile.yml (--pin vX.Y.Z)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.yml$/"],
      "matchStrings": ["--pin (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "github/gh-actions-lock"
    }
  ],
  "packageRules": [
    {
      "description": "Tout sauf les majeures : fusion automatique une fois la CI verte",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Extension gh-actions-lock (0.x, format du verrou encore mouvant) : jamais d'automerge, donc hors du groupe",
      "matchDepNames": ["github/gh-actions-lock"],
      "groupName": null,
      "automerge": false
    }
  ]
}
